/*
 * Jenkins declarative pipeline for the DevOps Deployment Monitor.
 *
 *   CI : checkout -> environment check -> frontend install/build ->
 *        backend install/validate
 *   CD : Docker build -> Docker Hub push -> GitOps manifest update
 *        (Argo CD picks up the manifest change and rolls out Kubernetes)
 *
 * Optional stages skip themselves automatically when their settings are not
 * present, so the pipeline still runs out of the box in CI-only mode.
 *
 * Configure as Jenkins credentials / job environment variables:
 *   DOCKERHUB_USER        Docker Hub account, e.g. "pranjal"        (enables push)
 *   DOCKERHUB_CREDENTIALS Jenkins credentials id of the Docker Hub login
 *   MANIFEST_REPO_URL     GitOps manifest repository https URL      (enables manifest update)
 *   MANIFEST_CREDENTIALS  Jenkins credentials id for the manifest repo
 *   APP_VERSION           optional version override, defaults to 1.0.0
 */

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        APP_VERSION    = "${env.APP_VERSION ?: '1.0.0'}"
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        BACKEND_IMAGE  = "${env.DOCKERHUB_USER ?: 'your-dockerhub-user'}/devops-monitor-backend"
        FRONTEND_IMAGE = "${env.DOCKERHUB_USER ?: 'your-dockerhub-user'}/devops-monitor-frontend"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub'
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                echo 'Checking Jenkins build environment'

                sh 'whoami'
                sh 'git --version'
                sh 'java --version'
                sh 'node --version'
                sh 'npm --version'
                sh 'docker --version'

                echo 'Environment check completed'
            }
        }

        stage('Frontend Install') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Frontend Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Backend Install') {
            steps {
                dir('backend') {
                    sh 'npm install'
                }
            }
        }

        stage('Backend Validation') {
            steps {
                dir('backend') {
                    sh 'node --check src/server.js'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker images'
                sh "docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} -t ${BACKEND_IMAGE}:latest ./backend"
                sh "docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} -t ${FRONTEND_IMAGE}:latest --build-arg VITE_APP_VERSION=${APP_VERSION} --build-arg VITE_BUILD_NUMBER=${IMAGE_TAG} --build-arg VITE_GIT_COMMIT=${GIT_COMMIT} --build-arg VITE_APP_MESSAGE='Deployed by Jenkins build #${IMAGE_TAG}' ./frontend"
            }
        }

        stage('Docker Hub') {
            // Only runs when DOCKERHUB_USER and DOCKERHUB_CREDENTIALS are set.
            when {
                expression {
                    return (env.DOCKERHUB_USER?.trim() ?: '') != '' &&
                           (env.DOCKERHUB_CREDENTIALS?.trim() ?: '') != ''
                }
            }
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', env.DOCKERHUB_CREDENTIALS) {
                        sh "docker push ${BACKEND_IMAGE}:${IMAGE_TAG}"
                        sh "docker push ${BACKEND_IMAGE}:latest"
                        sh "docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}"
                        sh "docker push ${FRONTEND_IMAGE}:latest"
                    }
                }
            }
        }

        stage('Argo CD') {
            // Only runs when MANIFEST_REPO_URL and MANIFEST_CREDENTIALS are set.
            when {
                expression {
                    return (env.MANIFEST_REPO_URL?.trim() ?: '') != '' &&
                           (env.MANIFEST_CREDENTIALS?.trim() ?: '') != ''
                }
            }
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: env.MANIFEST_CREDENTIALS,
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )]) {
                        sh '''
                            set -e
                            rm -rf .gitops
                            git clone "https://${GIT_USER}:${GIT_TOKEN}@${MANIFEST_REPO_URL#https://}" .gitops

                            # Point the manifests at the freshly built images.
                            sed -i "s#image: .*devops-monitor-backend:.*#image: ${BACKEND_IMAGE}:${IMAGE_TAG}#" .gitops/*.yaml || true
                            sed -i "s#image: .*devops-monitor-frontend:.*#image: ${FRONTEND_IMAGE}:${IMAGE_TAG}#" .gitops/*.yaml || true

                            cd .gitops
                            git config user.email "jenkins@ci.local"
                            git config user.name  "Jenkins CI"
                            git add -A
                            git commit -m "Deploy build #${IMAGE_TAG}" || echo "nothing to commit"
                            git push
                        '''
                    }
                }
            }
        }

        stage('Kubernetes') {
            steps {
                echo 'Argo CD syncs the updated manifests and rolls out the new pods.'
                echo "Backend  image : ${BACKEND_IMAGE}:${IMAGE_TAG}"
                echo "Frontend image : ${FRONTEND_IMAGE}:${IMAGE_TAG}"
            }
        }

        stage('Build Information') {
            steps {
                echo "Build Number: ${BUILD_NUMBER}"
                echo "Job Name: ${JOB_NAME}"
                echo "Workspace: ${WORKSPACE}"
                echo "Commit: ${GIT_COMMIT}"
                echo "Version: ${APP_VERSION}"
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully - the dashboard should now show the new version.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }
    }
}
