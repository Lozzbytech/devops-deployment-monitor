# ---------------------------------------------------------------------------
# Backend environment variables for the DevOps Deployment Monitor
# Copy this file to `.env` for local development.
# In CI/CD these values are injected by Jenkins / Kubernetes (ConfigMap + env).
# ---------------------------------------------------------------------------

# Port the API listens on
PORT=5000

# Application metadata (this is what the dashboard displays)
APP_VERSION=1.0.0
BUILD_NUMBER=1
GIT_COMMIT=local
APP_ENV=development

# Comma separated list of allowed CORS origins (use * for the demo)
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Kubernetes integration (optional)
# When a cluster is reachable the Infrastructure page shows LIVE cluster data
# instead of mock data. Auth uses the pod's ServiceAccount when running inside
# Kubernetes, or your local kubeconfig (KUBECONFIG / ~/.kube/config) otherwise.
# ---------------------------------------------------------------------------
K8S_NAMESPACE=default
