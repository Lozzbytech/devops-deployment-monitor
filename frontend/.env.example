# ---------------------------------------------------------------------------
# Frontend build-time environment variables (Vite exposes VITE_* to the app)
# Copy to `.env` for local development, or pass as Docker build args in CI/CD.
# ---------------------------------------------------------------------------

# Message shown in the dashboard footer. Change this to visibly verify a
# new CI/CD deployment. Example: "Deployed by Jenkins build #42"
VITE_APP_MESSAGE=Deployed via Jenkins + Argo CD

# Version/build metadata baked into the frontend bundle at build time
VITE_APP_VERSION=1.0.0
VITE_BUILD_NUMBER=1
VITE_GIT_COMMIT=local
